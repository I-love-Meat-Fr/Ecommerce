# Copy to .env and adjust as needed.
#
# Choose ONE connection source:
#   1) Local Docker Compose (default) — leave MONGO_CONNECTION_STRING empty.
#   2) MongoDB Atlas (cloud, share with team) — set MONGO_CONNECTION_STRING to the
#      SRV URI from Atlas: Database -> Connect -> Drivers -> .NET. Example format:
#        mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/ecommer?retryWrites=true&w=majority
#      URL-encode special chars in <password>: @ %23, : %3A, @ %40, / %2F

# ----- Local Docker (default) -----
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DB=ecommer

# Optional: change GUI credentials (mongo-express web UI at http://localhost:8081)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin123

# ----- Atlas (cloud) -----
# Leave empty to use local Docker. Set to an SRV URI to override and skip local mongo.
# The .NET API reads this via the env var ConnectionStrings__MongoDB
# (set it in your shell, or via docker-compose env_file, or via IDE launch settings).
# Atlas example:
#   MONGO_CONNECTION_STRING=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/ecommer?retryWrites=true&w=majority
# URL-encode special chars in <password>: @ %23, : %3A, @ %40, / %2F
MONGO_CONNECTION_STRING=